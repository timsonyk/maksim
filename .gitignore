# Secrets — НИКОГДА не коммитим
.env
.env.local
.env.*.local

# uv / venv
.venv/
.python-version

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
*.egg

# Build artifacts (PyInstaller)
dist/
build/

# Custom wake models — игнорим любые свежие/чужие, но allow-list для baseline
# "максим" модели, которая шипится с репо.
models/*.onnx
models/*.onnx.data
models/*.tflite
models/*.pt
models/*.bin
!models/maksim.onnx
!models/maksim.onnx.data

# IDE / OS
.DS_Store
.vscode/
.idea/
*.swp
.claude/   # local Claude Code settings, never share

# Test/coverage caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# Logs
*.log
log.jsonl
