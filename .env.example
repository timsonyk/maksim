# ───────────────────────────────────────────────────────────────
# Maksim — конфигурация.
# Скопируй этот файл в .env.local и заполни своими ключами.
# .env.local в .gitignore — туда никогда не попадёт в коммит.
# ───────────────────────────────────────────────────────────────

# ─── API keys ──────────────────────────────────────────────────
# ANTHROPIC — обязательно (LLM-мозг)
# GROQ — рекомендуется (быстрая cloud STT через Whisper). Можно без —
#   тогда STT_PROVIDER=local и faster-whisper будет крутиться на CPU.
# ELEVENLABS — нужен только если TTS_PROVIDER=elevenlabs. По умолчанию
#   используется Silero TTS локально — ключ не нужен.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
ELEVENLABS_API_KEY=

# ─── LLM ───────────────────────────────────────────────────────
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.4

# ─── STT ───────────────────────────────────────────────────────
# "groq"   — облако, быстро (~200мс), нужен GROQ_API_KEY
# "local"  — offline через faster-whisper (модель small/base скачивается)
# "hybrid" — Groq, при ошибке fallback на local (рекомендуется)
STT_PROVIDER=hybrid
STT_LANGUAGE=ru
GROQ_STT_MODEL=whisper-large-v3-turbo
LOCAL_STT_MODEL=small         # tiny/base/small/medium/large-v3
LOCAL_STT_COMPUTE=int8

# ─── TTS ───────────────────────────────────────────────────────
# "silero"     — offline, мужской голос aidar (по умолчанию)
# "say"        — macOS native Milena (мгновенно, попроще)
# "elevenlabs" — высокое качество, нужен баланс + ключ; в RU гео-блок,
#                может требовать VPN или пополненный аккаунт
TTS_PROVIDER=silero
SILERO_SPEAKER=aidar          # aidar / eugene (м); baya / kseniya / xenia (ж)
SAY_VOICE=Milena
SAY_RATE=200

# Если TTS_PROVIDER=elevenlabs — какой голос использовать.
# Voice Library: https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=pcm_22050

# ─── Wake-word ─────────────────────────────────────────────────
# По умолчанию используется русская модель "Максим" из models/maksim.onnx
# (обучена на синтетике Silero TTS, ~50k шагов).
# Альтернативы — встроенные английские модели openWakeWord:
#   hey_jarvis, alexa, hey_mycroft, hey_rhasspy.
# Чтобы натренировать своё слово — см. scripts/train_wake_word.ipynb (Colab).
WAKE_WORD=models/maksim.onnx
# 0.5 — чувствительный, 0.85 — строгий. Под "Максим" обычно 0.7-0.85.
WAKE_THRESHOLD=0.85

# ─── VAD endpointing ───────────────────────────────────────────
VAD_SILENCE_MS=600
VAD_MIN_SPEECH_MS=200
VAD_MAX_UTTERANCE_S=15

# ─── Audio ─────────────────────────────────────────────────────
SAMPLE_RATE=16000
INPUT_DEVICE=
OUTPUT_DEVICE=

# ─── Behaviour ─────────────────────────────────────────────────
PERSONA="Ты Максим — личный голосовой ассистент. Не используй обращения вроде «босс», «сэр», «хозяин» — обращайся к пользователю на «ты» без титулов. Отвечай кратко, в одну-две фразы, на русском. Используй инструменты для управления компьютером без лишних подтверждений. Не объясняй что собираешься делать — просто делай и коротко сообщи результат. Если действие необратимое, скажи об этом одной фразой и сразу делай. Если тебя спросят «кто ты» — отвечай что ты Максим. У тебя три уровня памяти: (1) краткосрочная — последние реплики этой сессии, ты их видишь автоматически; (2) полная история — все прошлые реплики, доступна через recall_conversation (используй когда спрашивают «что я говорил N минут назад», «о чём мы говорили», «напомни про X»); (3) долгосрочная — структурированные факты о пользователе, доступная через remember/forget/list_facts. Проактивно сохраняй важные стабильные факты (имя, город, проекты, предпочтения по голосу/модели, важные люди) через remember с понятным snake_case ключом. На команду «забудь X» вызывай forget. Если спросят «что ты обо мне помнишь» — вызывай list_facts."

# Confirmation policy: none | destructive
# "destructive" просит голосовое «да» перед rm/sudo/shutdown.
CONFIRM_POLICY=none

# Где хранить state — лог, история диалога, кэш.
MAKSIM_HOME=~/.maksim
